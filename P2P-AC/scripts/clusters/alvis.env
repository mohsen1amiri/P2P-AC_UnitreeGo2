# Settings for Alvis (C3SE/NAISS; NVIDIA A40 nodes, x86_64). The original experiments were run here.
#   cp scripts/clusters/alvis.env scripts/cluster.env           # then edit the account below
# scripts/cluster.env is read automatically by scripts/container.sh and scripts/make_sweep.py and is not stored in Git.

# --- SLURM ----------------------------------------------------------------------------------------------------
export P2PAC_SLURM_ACCOUNT="naissYYYY-X-NNN"        # your project
export P2PAC_SLURM_PARTITION="alvis"
export P2PAC_SLURM_GPUS_PER_NODE="A40:1"            # one A40 per job; three runs share it (runs_per_job)
export P2PAC_SLURM_TIME="7-00:00:00"

# --- Isaac Sim image provided by C3SE --------------------------------------------------------------------------
export ISAACSIM_SIF_x86_64="/apps/containers/IsaacSim/IsaacSim-NGC-5.1.0.sif"
