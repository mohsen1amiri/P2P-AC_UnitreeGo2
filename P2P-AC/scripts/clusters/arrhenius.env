# Settings for Arrhenius (NAISS; GPU partition: NVIDIA GH200 Grace Hopper nodes).
#   cp scripts/clusters/arrhenius.env scripts/cluster.env      # then edit the account below
# scripts/cluster.env is read automatically by scripts/container.sh and scripts/make_sweep.py and is not stored in Git.
#
# About the GPU nodes: each node has 4 GH200 superchips (one 72-core ARM Grace CPU with ~120 GB memory plus one
# Hopper GPU with 96 GB each). The CPU architecture is aarch64 (ARM), unlike the x86_64 login node, so everything that
# runs inside the container (installation, smoke test, training) must run on a GPU node. Nodes are shared between
# jobs, so CPUs and memory are requested explicitly.
# IMPORTANT: NVIDIA does not officially support Isaac Sim on GH200 (README, Section 4). Run the acceptance test
# (scripts/isaac_smoke_test.py) on a GPU node before launching experiments.

# --- SLURM ----------------------------------------------------------------------------------------------------
export P2PAC_SLURM_ACCOUNT="naissYYYY-X-NN-gpu"     # your GPU project: the account name must end in -gpu
export P2PAC_SLURM_PARTITION="gpu"
export P2PAC_SLURM_GPUS="1"                         # one GH200 per job; three runs share it (runs_per_job)
export P2PAC_SLURM_CPUS_PER_TASK="36"               # half of the 72 cores that belong to one GH200 (adjust)
export P2PAC_SLURM_MEM="100G"                       # of the ~120 GB CPU memory that belong to one GH200 (adjust)
export P2PAC_SLURM_TIME="3-00:00:00"                # must not exceed the partition limit: sinfo -p gpu -o "%P %l"

# --- Isaac Sim image (must be stored outside $HOME on Arrhenius; the repository folder is fine) ----------------
# Default: <repo>/container/isaac-sim-5.1.0-aarch64.sif, made by:  bash scripts/setup/get_container.sh --arch aarch64
# export ISAACSIM_SIF_aarch64="/nobackup/proj/disk/<project>/isaac-sim-5.1.0-aarch64.sif"

# --- Isaac Sim caches on the node-local disk (many small files; keeps them off the project file quota) -----------
if [ -d /scratch/local ] && [ -w /scratch/local ]; then
  export P2PAC_CACHE_ROOT="/scratch/local/${USER}/p2pac_isaac_cache"
fi
